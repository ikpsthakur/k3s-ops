# Copy to .env and edit. Quote values containing spaces or shell characters.

# Kubernetes
NAMESPACE=monitoring
STORAGE_CLASS=longhorn
VM_STORAGE_SIZE=2Gi
VM_RETENTION=7d
SCRAPE_INTERVAL=60s
CLUSTER_NAME=k3s-home

# Pinned images
VICTORIA_METRICS_IMAGE=victoriametrics/victoria-metrics:v1.147.0
VMAGENT_IMAGE=victoriametrics/vmagent:v1.147.0
VMALERT_IMAGE=victoriametrics/vmalert:v1.147.0
KUBE_STATE_METRICS_IMAGE=registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.19.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.33.1

# SMTP / email notifications
# Gmail example: SMTP_SMARTHOST=smtp.gmail.com:587 and use an App Password.
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=k3s-alerts@example.com
SMTP_USERNAME=k3s-alerts@example.com
SMTP_PASSWORD='replace-me'
ALERT_EMAIL_TO=you@example.com
SMTP_REQUIRE_TLS=true

# Alert routing
ALERT_GROUP_WAIT=30s
ALERT_GROUP_INTERVAL=5m
ALERT_REPEAT_INTERVAL=4h
CRITICAL_REPEAT_INTERVAL=1h
